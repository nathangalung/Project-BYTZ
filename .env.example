# Copy to .env for local development. Never commit the copy.
#
# Values marked REQUIRED abort `docker compose -f docker-compose.prod.yml up`
# when unset, rather than interpolating to an empty string. Everything else has
# a working default for the local stack in docker-compose.yml.

# Database. DATABASE_URL goes through PgBouncer in transaction mode, which
# cannot run migrations, so drizzle-kit uses DATABASE_DIRECT_URL instead.
DATABASE_URL=postgresql://kerjacus:kerjacus@localhost:6432/kerjacus
DATABASE_DIRECT_URL=postgresql://kerjacus:kerjacus@localhost:5432/kerjacus
DB_USER=kerjacus
DB_PASSWORD=kerjacus
DB_NAME=kerjacus

# Valkey speaks RESP, so the redis:// scheme is correct.
REDIS_URL=redis://localhost:6379
NATS_URL=nats://localhost:4222

# Auth. BETTER_AUTH_SECRET must be at least 32 characters.
BETTER_AUTH_SECRET=replace-with-32-plus-random-characters
BETTER_AUTH_URL=http://localhost:3001
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Shared secret for service-to-service calls on /internal and X-Service-Auth.
SERVICE_AUTH_SECRET=replace-with-a-random-secret

# One key for both models. Inference is z-ai/glm-5.3 and embeddings are
# voyageai/voyage-4-large, both through OpenRouter at
# https://openrouter.ai/api/v1. Get a key at openrouter.ai/keys.
#
# OpenRouter returns usage.cost, the amount actually charged, so
# ai_interactions.cost_usd stores a reported figure rather than tokens
# multiplied by a rate table maintained here. That table drifted once and
# priced GLM at Gemini's rates for months. The rates below remain as a
# fallback for a response that carries no cost.
#
# A model id is served by several providers at different speeds, and the
# service states a preference rather than accepting the default. Measured over
# 36 interleaved samples, letting OpenRouter choose gave a first-token P95 of
# 11.65s against 3.29s direct to Z.ai, because three providers served the same
# model and the slowest set the tail. Pinned to BaseTen the same measurement
# was 1.83s. See PROVIDER_ORDER in app/services/llm.py.
#
# GLM-5.3 always reasons and OpenRouter takes reasoning.effort rather than
# Z.ai's thinking.type pair. The service pins it to low, because the default
# spends output budget on reasoning the product never shows.
#
# voyage-4-large over voyage-4 at 1024 dimensions. The price gap is about a
# dollar a year at this volume, and retrieval quality gates every passage the
# model sees, so the cheaper retriever saves nothing worth having.
OPENROUTER_API_KEY=

# Token prices, USD per million, written to ai_interactions.cost_usd and summed
# by the admin AI cost dashboard. Used only when a response carries no cost of
# its own, since OpenRouter reports what it charged. Defaults are the published
# glm-5.3 and voyage rates. Set these to track a price change without waiting
# for a deploy, and remember stored rows keep the price in force when written.
# AI_PROMPT_USD_PER_MTOK=1.40
# AI_COMPLETION_USD_PER_MTOK=4.40
# AI_EMBED_USD_PER_MTOK=0.06

# Storage. The bucket is private except the avatar/ prefix; everything else is
# read through presigned GET. S3_PUBLIC_URL is the host the browser can reach,
# which differs from the internal endpoint the services use.
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=
S3_BUCKET=kerjacus-uploads
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Payments. MIDTRANS_IS_SANDBOX is the only switch that matters: config.go
# builds the Snap URL from it, and the web build picks the matching snap.js
# host. Sandbox and production tokens are not interchangeable.
MIDTRANS_SERVER_KEY=SB-Mid-server-replace-me
MIDTRANS_CLIENT_KEY=SB-Mid-client-replace-me
MIDTRANS_IS_SANDBOX=true

# Email and SMS OTP.
RESEND_API_KEY=
ZENZIVA_USER_KEY=
ZENZIVA_API_KEY=

# Real-time transport.
CENTRIFUGO_URL=http://localhost:8000
CENTRIFUGO_API_KEY=replace-with-a-random-key
CENTRIFUGO_SECRET=replace-with-a-random-secret

# Workflow orchestration.
TEMPORAL_URL=localhost:7233
TEMPORAL_NAMESPACE=kerjacus
TEMPORAL_TASK_QUEUE=project-service
TEMPORAL_DB_PASSWORD=temporal

# Observability, behind the `observability` compose profile in development.
# The password must be 8-128 characters with upper, lower, digit and symbol or
# OpenObserve panics at startup. The token is base64("user:password") and is
# sent as Authorization: Basic; empty makes OpenObserve reject every span.
OPENOBSERVE_USER=root@kerjacus.id
OPENOBSERVE_PASSWORD=KerjaCus#Dev1
OPENOBSERVE_OTLP_TOKEN=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:5080/api/default
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Frontend build arguments.
VITE_API_URL=http://localhost:80
VITE_APP_URL=http://localhost:5173
VITE_CENTRIFUGO_URL=ws://localhost:8000/connection/websocket
VITE_MIDTRANS_CLIENT_KEY=SB-Mid-client-replace-me
VITE_MIDTRANS_IS_SANDBOX=true
