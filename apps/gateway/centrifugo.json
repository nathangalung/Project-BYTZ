{
  "http_server": {
    "port": 8000
  },
  "admin": {
    "enabled": true,
    "password": "centrifugo-admin-dev",
    "secret": "centrifugo-admin-secret-dev"
  },
  "http_api": {
    "key": "centrifugo-api-key"
  },
  "client": {
    "token": {
      "hmac_secret_key": "centrifugo-secret"
    },
    "allowed_origins": ["http://localhost:5173", "http://localhost:80"],
    "channel_limit": 128,
    "stale_close_delay": "10s",
    "expired_close_delay": "25s",
    "user_connection_limit": 10
  },
  "channel": {
    "max_length": 255,
    "without_namespace": {
      "allow_subscribe_for_client": true,
      "presence": true,
      "join_leave": false,
      "history_size": 100,
      "history_ttl": "720h"
    },
    "namespaces": [
      {
        "name": "chat",
        "presence": true,
        "join_leave": true,
        "history_size": 200,
        "history_ttl": "168h",
        "allow_subscribe_for_client": true,
        "force_recovery": true,
        "force_positioning": true
      },
      {
        "name": "notifications",
        "presence": false,
        "join_leave": false,
        "history_size": 50,
        "history_ttl": "24h",
        "allow_subscribe_for_client": true,
        "force_recovery": true
      },
      {
        "name": "project-updates",
        "presence": true,
        "join_leave": false,
        "history_size": 100,
        "history_ttl": "72h",
        "allow_subscribe_for_client": true,
        "force_recovery": true,
        "force_positioning": true
      },
      {
        "name": "project",
        "presence": false,
        "join_leave": false,
        "history_size": 50,
        "history_ttl": "24h",
        "allow_subscribe_for_client": true,
        "force_recovery": true
      },
      {
        "name": "milestone",
        "presence": false,
        "join_leave": false,
        "history_size": 50,
        "history_ttl": "24h",
        "allow_subscribe_for_client": true,
        "force_recovery": true
      }
    ]
  },
  "log": {
    "level": "info"
  },
  "health": {
    "enabled": true
  }
}
