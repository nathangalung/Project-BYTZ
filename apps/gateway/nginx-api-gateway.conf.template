# KerjaCUS! API Gateway
#
# This file is a TEMPLATE and is the single routing table for every
# environment. The nginx entrypoint expands ${KC_*} at container start;
# NGINX_ENVSUBST_FILTER pins substitution to that prefix so nginx's own
# $host, $remote_addr and $request_method survive untouched.
#
# Development used to route through Traefik with a second copy of this table
# in apps/gateway/dynamic.yml. The copies drifted: dev never had the
# /api/v1/payments/internal refusal or the storage sandbox, so neither could
# be exercised before production.
# Single source of truth for CORS — strips duplicate headers from backends

resolver 127.0.0.11 valid=10s ipv6=off;

# Extra origins arrive as an include rather than as a substituted value.
# Development genuinely needs origins production must never echo, and the
# image ships an empty file so a missing mount cannot silently widen this.
# Decide whether CF-Connecting-IP was written by Cloudflare or by the caller.
#
# The rate limiter keys on that header (packages/shared/src/client-ip.ts), and
# until now nginx passed through whatever arrived. api.kerjacus.id resolves
# straight to the origin with Cloudflare switched off, so anyone could send a
# fresh CF-Connecting-IP per request and never meet the ten-per-minute limit on
# the credential paths, or send someone else's address and spend their quota.
#
# nginx cannot see the true peer: every request arrives through Dokploy's
# Traefik either way. What it can see is that Traefik APPENDS its own peer to
# X-Forwarded-For, and that value is not forgeable by the caller. So the last
# element answers the question - a Cloudflare edge address means the request
# came through Cloudflare, anything else means it reached the origin directly.
map $http_x_forwarded_for $xff_peer {
    default $http_x_forwarded_for;
    "~,\s*(?<last>[^,\s]+)\s*$" $last;
}

geo $xff_peer $peer_is_cloudflare {
    default 0;
    include /etc/nginx/cloudflare-ips.conf;
}

# Behind Cloudflare, keep the header it wrote. Otherwise replace it with the
# address Traefik observed, so a direct caller is counted under their own
# address rather than one they chose. Empty means nginx omits the header and
# the service falls back to X-Real-IP, which this tier also sets.
map $peer_is_cloudflare $trusted_client_ip {
    1 $http_cf_connecting_ip;
    0 $xff_peer;
}

map $http_origin $cors_origin {
    default "";
    "https://kerjacus.id" "https://kerjacus.id";
    "https://www.kerjacus.id" "https://www.kerjacus.id";
    "https://admin.kerjacus.id" "https://admin.kerjacus.id";
    include /etc/nginx/cors-extra-origins.conf;
}

server {
    # Both families are declared here rather than left to the entrypoint.
    # 10-listen-on-ipv6-by-default.sh patches conf.d BEFORE 20-envsubst renders
    # this template over the top, so anything it adds is discarded. The previous
    # Dockerfile copied a finished config and did get IPv6 from that script; not
    # writing it down would quietly drop a listener the image used to have.
    listen 80;
    listen [::]:80;
    server_name _;

    # Take the client address the web tier already resolved.
    #
    # Every location here sets X-Real-IP from $remote_addr, and this tier's
    # peer is the web container, so without this the correct value resolved
    # upstream is overwritten with 10.0.1.65 before it reaches any service.
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    real_ip_header X-Real-IP;

    # Strip backend CORS headers so we don't get duplicates
    proxy_hide_header Access-Control-Allow-Origin;
    proxy_hide_header Access-Control-Allow-Credentials;
    proxy_hide_header Access-Control-Allow-Methods;
    proxy_hide_header Access-Control-Allow-Headers;
    proxy_hide_header Access-Control-Max-Age;
    proxy_hide_header Vary;

    # Add our CORS headers to all proxied responses
    add_header Access-Control-Allow-Origin $cors_origin always;
    add_header Access-Control-Allow-Credentials "true" always;
    add_header Vary "Origin" always;

    # Security headers. This origin had none: kerjacus.id/api/* inherited the
    # web tier's set, while the identical endpoint on api.kerjacus.id got
    # nothing. Every location below declares its own add_header for CORS, and
    # nginx replaces rather than merges, so these are repeated per location.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Preflight handler
    location = /cors-preflight {
        internal;
        add_header Access-Control-Allow-Origin $cors_origin;
        add_header Access-Control-Allow-Credentials "true";
        add_header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS";
        add_header Access-Control-Allow-Headers "Content-Type, Authorization, Cookie, X-Request-ID, X-Service-Auth";
        add_header Access-Control-Max-Age "86400";
        add_header Content-Length 0;
        add_header Content-Type "text/plain";
        return 204;
    }

    # All /api/ locations — handle OPTIONS via error_page trick
    location /api/ {
        # Route OPTIONS to internal preflight handler
        error_page 418 = /cors-preflight;
        recursive_error_pages on;
        if ($request_method = 'OPTIONS') {
            return 418;
        }

        # Default: proxy to project-service (catch-all for /api/v1/*)
        set $upstream http://${KC_PROJECT_UPSTREAM};
        proxy_pass $upstream;
        proxy_set_header Host $host;
        proxy_set_header CF-Connecting-IP $trusted_client_ip;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Cookie $http_cookie;
    }

    # Auth service
    location /api/v1/auth/ {
        error_page 418 = /cors-preflight;
        recursive_error_pages on;
        if ($request_method = 'OPTIONS') { return 418; }

        set $upstream http://${KC_AUTH_UPSTREAM};
        proxy_pass $upstream;
        proxy_set_header Host $host;
        proxy_set_header CF-Connecting-IP $trusted_client_ip;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Cookie $http_cookie;
    }

    location /api/v1/me {
        error_page 418 = /cors-preflight;
        recursive_error_pages on;
        if ($request_method = 'OPTIONS') { return 418; }

        set $upstream http://${KC_AUTH_UPSTREAM};
        proxy_pass $upstream;
        proxy_set_header Host $host;
        proxy_set_header CF-Connecting-IP $trusted_client_ip;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Cookie $http_cookie;
    }

    location /api/v1/phone {
        error_page 418 = /cors-preflight;
        recursive_error_pages on;
        if ($request_method = 'OPTIONS') { return 418; }

        set $upstream http://${KC_AUTH_UPSTREAM};
        proxy_pass $upstream;
        proxy_set_header Host $host;
        proxy_set_header CF-Connecting-IP $trusted_client_ip;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Cookie $http_cookie;
    }

    # AI service
    location /api/v1/ai {
        error_page 418 = /cors-preflight;
        recursive_error_pages on;
        if ($request_method = 'OPTIONS') { return 418; }

        set $upstream http://${KC_AI_UPSTREAM};
        proxy_pass $upstream;
        proxy_set_header Host $host;
        proxy_set_header CF-Connecting-IP $trusted_client_ip;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Cookie $http_cookie;
        proxy_read_timeout 120s;
    }

    # Service-to-service payment paths. These release escrow and issue refunds
    # on the strength of X-Service-Auth alone, with no session behind them, so
    # the public edge must never proxy them. Longest-prefix wins in nginx, so
    # this beats the /api/v1/payments block below regardless of order. 404 and
    # not 403, because a refusal that confirms the path exists is a map.
    location /api/v1/payments/internal {
        return 404;
    }

    # Payment service
    location /api/v1/payments {
        error_page 418 = /cors-preflight;
        recursive_error_pages on;
        if ($request_method = 'OPTIONS') { return 418; }

        set $upstream http://${KC_PAYMENT_UPSTREAM};
        proxy_pass $upstream;
        proxy_set_header Host $host;
        proxy_set_header CF-Connecting-IP $trusted_client_ip;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Cookie $http_cookie;
    }

    # Notification service
    location /api/v1/notifications {
        error_page 418 = /cors-preflight;
        recursive_error_pages on;
        if ($request_method = 'OPTIONS') { return 418; }

        set $upstream http://${KC_NOTIFICATION_UPSTREAM};
        proxy_pass $upstream;
        proxy_set_header Host $host;
        proxy_set_header CF-Connecting-IP $trusted_client_ip;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Cookie $http_cookie;
    }

    # Admin service
    location /api/v1/admin {
        error_page 418 = /cors-preflight;
        recursive_error_pages on;
        if ($request_method = 'OPTIONS') { return 418; }

        set $upstream http://${KC_ADMIN_UPSTREAM};
        proxy_pass $upstream;
        proxy_set_header Host $host;
        proxy_set_header CF-Connecting-IP $trusted_client_ip;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Cookie $http_cookie;
    }

    # Centrifugo WebSocket — strip /centrifugo/ prefix before passing to upstream
    location /centrifugo/ {
        rewrite ^/centrifugo/(.*) /$1 break;
        proxy_pass http://${KC_CENTRIFUGO_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header CF-Connecting-IP $trusted_client_ip;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400s;
    }

    # MinIO / S3 object storage — direct browser upload via presigned URLs.
    # proxy_pass trailing slash strips /storage/ prefix automatically (no rewrite needed).
    # Host override must match what was signed in the presigned URL (minio:9000).
    # OPTIONS routed to @storage_preflight via error_page trick (MinIO returns 405 for OPTIONS).
    location /storage/ {
        error_page 418 = @storage_preflight;
        recursive_error_pages on;
        if ($request_method = 'OPTIONS') { return 418; }

        # No CF-Connecting-IP here, unlike every other location: this one
        # reaches MinIO, which neither reads the header nor sits behind the
        # rate limiter.
        proxy_pass http://${KC_MINIO_UPSTREAM}/;
        proxy_set_header Host ${KC_MINIO_UPSTREAM};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;
        client_max_body_size 20m;

        add_header Access-Control-Allow-Origin $cors_origin always;
        add_header Access-Control-Allow-Methods "GET, PUT, HEAD, OPTIONS" always;
        add_header Vary Origin always;

        # Uploaded bytes served from the API origin, which shares a registrable
        # domain with the app. The presign now allows only a fixed set of
        # content types, and these three make the remainder inert even if a
        # file's bytes do not match the type it was stored under: never sniff a
        # type, never render in place, and no script or embed may run under this
        # CSP. sandbox drops same-origin, so anything that does render cannot
        # touch cookies or storage.
        add_header X-Content-Type-Options "nosniff" always;
        add_header Content-Disposition "attachment" always;
        add_header Content-Security-Policy "default-src 'none'; sandbox" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    }

    location @storage_preflight {
        add_header Access-Control-Allow-Origin $cors_origin always;
        add_header Access-Control-Allow-Methods "GET, PUT, HEAD, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Content-MD5, Authorization, x-amz-date, x-amz-content-sha256, x-amz-security-token, x-amz-checksum-crc32, x-amz-sdk-checksum-algorithm" always;
        add_header Access-Control-Max-Age 86400 always;
        add_header Vary Origin always;
        add_header Content-Length 0;
        add_header Content-Type "text/plain";
        return 204;
    }

    # Health
    location /health {
        add_header Content-Type application/json always;
        add_header Access-Control-Allow-Origin $cors_origin always;
        add_header X-Content-Type-Options "nosniff" always;
        return 200 '{"status":"ok","service":"api-gateway"}';
    }
}
