FROM nginx:alpine

# The routing table ships as a template. nginx's entrypoint expands it at
# container start, and the filter pins substitution to the KC_ prefix so
# nginx's own $host and $remote_addr are not eaten by envsubst.
ENV NGINX_ENVSUBST_FILTER=^KC_
COPY nginx-api-gateway.conf.template /etc/nginx/templates/default.conf.template

# Sourced by the entrypoint before envsubst. Development points upstreams at
# the host, and nginx cannot resolve that name through the resolver alone.
COPY --chmod=755 16-resolve-host-upstreams.envsh /docker-entrypoint.d/16-resolve-host-upstreams.envsh

# Empty by default. Development mounts over it; production must not echo a
# localhost origin, so the file being absent is not an option.
COPY cors-extra-origins.conf /etc/nginx/cors-extra-origins.conf

# Cloudflare's edge ranges, generated and drift-checked in CI. The gateway
# reads them to decide whether CF-Connecting-IP was written by Cloudflare or
# by the caller; absent, the geo include fails and nginx refuses to start.
COPY cloudflare-ips.conf /etc/nginx/cloudflare-ips.conf
